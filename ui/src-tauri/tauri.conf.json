{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dagger",
  "version": "0.0.0",
  "identifier": "com.redo.dagger",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dagger",
        "width": 1280,
        "height": 860
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
